<%- include("partials/header.ejs") %>
    <div class="read trending container">
            <h3>Trending</h3>
            <p>Expresso Martini</p>
            <p>Classic Mojito</p>
            <p>Blue Lagoon</p>
            <p>Pina Colada</p>
    </div>
    <div class="read posts container">
        <div class="details">
            <h1><%= content.drinks[feedIndexArr].strDrink %></h1>
            <div class="post card">
                <img src="<%= content.drinks[feedIndexArr].strDrinkThumb %>" alt="image of a cocktail"><br>
                <div class="specs">
                    <p>Category : <br> <%= content.drinks[feedIndexArr].strCategory %></p>
                    <p>Drink Type : <br> <%= content.drinks[feedIndexArr].strAlcoholic %></p>
                    <p>Glass Type : <br> <%= content.drinks[feedIndexArr].strGlass %></p>
                </div>
                <div class="steps">
                    <h2>Ingredients :</h2>
                    <ul>
                        <% for(let i=1; i<16; i++){ %>
                            <%let ingredValue = "strIngredient"+i%>
                            <%let measureValue = "strMeasure"+i%>
                            <%if (!(content.drinks[feedIndexArr][ingredValue] === null)){%>
                                <%console.log(content.drinks[feedIndexArr][ingredValue]);%>
                                <li><%=content.drinks[feedIndexArr][measureValue]%> of <%=content.drinks[feedIndexArr][ingredValue]%></li>
                            <%}%>
                        <%};%>
                    </ul>
                    <h2>Recipe:</h2>
                    <%console.log(content.drinks[feedIndexArr].strInstructions.length)%>
                    <%let recipeArr = content.drinks[feedIndexArr].strInstructions%>
                    <%let lineArr = "";%>
                    <ol>
                        <%for(let j=0; j<recipeArr.length; j++){%> 
                            <%if (recipeArr[j] === "."){%>
                                <%console.log(lineArr)%>
                                <li><%=lineArr%></li>
                                <%lineArr = ""%>
                            <%} else {%>
                                <%lineArr= lineArr+recipeArr[j]%>
                            <%}%>
                        <%};%>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="read extras container">
        <h3>Extras</h3>
        <p>For You</p>
        <p>Discover</p>
        <p>Saved Drinks</p>
    </div>
<%- include("partials/footer.ejs") %>