<%- include("partials/header.ejs") %>
    <div class="read trending container">
            <h3>Trending</h3>
            <p>Expresso Martini</p>
            <p>Classic Mojito</p>
            <p>Blue Lagoon</p>
            <p>Pina Colada</p>
    </div>
    <div class="read posts container">
        <div class="details">
            <h1><%= content.drinks[feedIndexArr].strDrink %></h1>
            <div class="post card">
                <img src="<%= content.drinks[feedIndexArr].strDrinkThumb %>" alt="image of a cocktail"><br>
                <div class="specs">
                    <p>Category : <br> <%= content.drinks[feedIndexArr].strCategory %></p>
                    <p>Drink Type : <br> <%= content.drinks[feedIndexArr].strAlcoholic %></p>
                    <p>Glass Type : <br> <%= content.drinks[feedIndexArr].strGlass %></p>
                </div>
                <div>
                    <h2>Ingredients :</h2>
                    <% for(let i=1; i<16; i++){ %>
                        <%let value = "strIngredient"+i%>
                        <%if (!(content.drinks[feedIndexArr][value] === null)){%>
                            <%console.log(content.drinks[feedIndexArr][value]);%>
                            <li><%=content.drinks[feedIndexArr][value]%></li>
                        <%}%>
                    <%};%>
                </div>
                <h2>Recipe:</h2>
                <p><%= content.drinks[feedIndexArr].strInstructions %></p>
            </div>
        </div>
    </div>
    <div class="read extras container">
        <h3>Extras</h3>
        <p>For You</p>
        <p>Discover</p>
        <p>Saved Drinks</p>
    </div>
<%- include("partials/footer.ejs") %>