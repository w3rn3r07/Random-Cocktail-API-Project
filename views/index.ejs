<%- include("partials/header.ejs") %>
    <div class="trending container">
        <h3>Trending</h3>
        <p>Expresso Martini</p>
        <p>Classic Mojito</p>
        <p>Blue Lagoon</p>
        <p>Pina Colada</p>
    </div>
    <div class="posts container">
        <h1>POSTS</h1>
        <hr>
        <div class="post card">
            <img src="<%= content.drinks[feedIndexArr[0]].strDrinkThumb %>" alt="image of a cocktail"><br>
            <h3><%= content.drinks[feedIndexArr[0]].strDrink %></h3>
            <h4>Category : <%= content.drinks[feedIndexArr[0]].strCategory %></h4>
            <h4>Alcoholic : <%= content.drinks[feedIndexArr[0]].strAlcoholic %></h4>
            <h4>Glass Type : <%= content.drinks[feedIndexArr[0]].strGlass %></h4>
            <a href="/drink/<%= feedIndexArr[0] %>"><button>Read More</button></a>
        </div>
        <hr>
        <div class="post card">
            <img src="<%= content.drinks[feedIndexArr[1]].strDrinkThumb %>" alt="image of a cocktail"><br>
            <h3><%= content.drinks[feedIndexArr[1]].strDrink %></h3>
            <h4>Category : <%= content.drinks[feedIndexArr[1]].strCategory %></h4>
            <h4>Alcoholic : <%= content.drinks[feedIndexArr[1]].strAlcoholic %></h4>
            <h4>Glass Type : <%= content.drinks[feedIndexArr[1]].strGlass %></h4>
            <a href="/drink/<%= feedIndexArr[1] %>"><button>Read More</button></a>
        </div>
        <hr>
        <div class="post card">
            <img src="<%= content.drinks[feedIndexArr[2]].strDrinkThumb %>" alt="image of a cocktail"><br>
            <h3><%= content.drinks[feedIndexArr[2]].strDrink %></h3>
            <h4>Category : <%= content.drinks[feedIndexArr[2]].strCategory %></h4>
            <h4>Alcoholic : <%= content.drinks[feedIndexArr[2]].strAlcoholic %></h4>
            <h4>Glass Type : <%= content.drinks[feedIndexArr[2]].strGlass %></h4>
            <a href="/drink/<%= feedIndexArr[2] %>"><button>Read More</button></a>
        </div>
    </div>
    <div class="extras container">
        <h3>Extras</h3>
        <p>For You</p>
        <p>Discover</p>
        <p>Saved Drinks</p>
    </div>
<%- include("partials/footer.ejs") %>